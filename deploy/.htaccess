<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>
    RewriteEngine On

    # Hostinger's FastCGI drops the Authorization header, which breaks every
    # Bearer-token request with no visible error.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Vite content-hashes these, so they can be cached indefinitely.
    <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # The service worker and manifest must never be cached hard, or a released
    # fix cannot reach a device that already installed the app.
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

# Belt and braces for a host misconfigured to a single document root.
<FilesMatch "^\.env|composer\.(json|lock)$">
    Require all denied
</FilesMatch>
