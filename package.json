{
    "name": "mulkihawler-frontend",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build && php scripts/frontend-guard.php",
        "build:ci": "vite build",
        "lint": "eslint resources/js --ext .ts,.vue",
        "format": "prettier --write \"resources/js/**/*.{ts,vue,css}\"",
        "typecheck": "vue-tsc --noEmit",
        "guard": "php scripts/frontend-guard.php && php scripts/lang-usage.php && php scripts/security-audit.php"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^22.10.0",
        "@vitejs/plugin-vue": "^5.2.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^9.32.0",
        "globals": "^15.15.0",
        "laravel-vite-plugin": "^1.1.0",
        "postcss": "^8.4.49",
        "postcss-rtlcss": "^5.6.0",
        "prettier": "^3.4.2",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^6.0.0",
        "vite-plugin-pwa": "^0.21.1",
        "vue-tsc": "^2.1.10"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "maplibre-gl": "^6.0.0",
        "pinia": "^2.3.0",
        "vue": "^3.5.13"
    }
}
