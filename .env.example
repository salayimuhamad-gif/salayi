# ==========================================================================
# Mulkihawler 4.0 — Environment Reference
# Full field-by-field documentation: docs/ENVIRONMENT_REFERENCE.md
# The guided web installer (/install) generates this file on a new install.
# NEVER commit a populated .env. NEVER overwrite APP_KEY during an upgrade.
# ==========================================================================

APP_NAME="Mulkihawler"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Baghdad

# --- Sorani-first localisation (spec 7.1) -------------------------------
# Fallback is deliberately ckb, not en: a missing key must never silently
# render English on a Sorani page. scripts/lang-parity.php is the guard.
APP_LOCALE=ckb
APP_FALLBACK_LOCALE=ckb
APP_FAKER_LOCALE=ar_IQ
APP_ENABLED_LOCALES=ckb,ar,en

# --- Installer ----------------------------------------------------------
MULKIHAWLER_INSTALLED=false
MULKIHAWLER_INSTALL_RESET_TOKEN=

# --- Database (MySQL 8 in production; sqlite for local tests) -----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mulkihawler
DB_USERNAME=mulkihawler
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Shared hosting profile (Hostinger: no Redis, no root) --------------
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Mail ---------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Security -----------------------------------------------------------
# Rotated independently of APP_KEY. Used for phone encryption + blind index.
MULKIHAWLER_PII_KEY=
MULKIHAWLER_BLIND_INDEX_KEY=

# How long an account that registered but never linked Telegram is kept before
# it is reclaimed (v7 account-first). Default 72 hours.
#
# Account-first creates a real row from a form submission, and `phone_index` is
# UNIQUE — so an abandoned registration holds a phone number away from the
# person who actually owns it, and creating one costs a single submission.
# Reclamation anonymizes the row and releases the number. Three days covers a
# weekend, which is the realistic gap between starting and coming back; lower it
# only with the recovery path in mind, because until it elapses the only way
# back into an unlinked account is the browser session that created it.
MULKIHAWLER_UNLINKED_RETENTION_HOURS=72
MULKIHAWLER_ADMIN_MFA_REQUIRED=true
MULKIHAWLER_FORCE_HTTPS=true

# --- Map provider (Step 2; abstraction registered in Step 1) ------------
# MAPLIBRE_STYLE_URL empty = the shipped MULK dark basemap
# (/map-styles/mulk-dark.json: official CARTO Dark Matter raster tiles,
# no API key, attribution built in). Set a URL only to override that
# default with another MapLibre style. A deployment whose env still points
# at an older light style should clear this value (or set it to
# /map-styles/mulk-dark.json) to adopt the dark map.
MAP_PROVIDER=maplibre
MAPLIBRE_STYLE_URL=
GOOGLE_MAPS_API_KEY=

# --- Overpass API (Map Phase 2: admin OSM place import) ------------------
# Public keyless OpenStreetMap query service used ONLY by the server-side
# admin import flow (never by visitors' browsers, never on a public page
# load). Not a secret. The default is the main community instance; point it
# at another Overpass instance only if you operate or are entitled to one.
# Responses are cached for 24 hours; requests carry an identifying
# User-Agent and bounded timeouts.
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# --- AI provider (Step 4; abstraction registered in Step 1) -------------
# AI_PROVIDER selects the primary provider: null | openai | gemini |
# openai_compatible. AI_FALLBACK_PROVIDER may name one fallback from the
# same set. Each provider carries its own key/model; openai_compatible also
# needs a base URL. Legacy AI_API_KEY / AI_MODEL / AI_BASE_URL remain read
# as openai_compatible defaults; AI_FALLBACK_MODEL is retired (the fallback
# model is the fallback provider's own model).
AI_PROVIDER=null
AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
AI_TIMEOUT=30
AI_MONTHLY_COST_LIMIT_USD=0
# USD per 1M tokens used to price usage against the monthly ceiling; at 0
# the ceiling cannot trip and the admin diagnostics say so.
AI_PROMPT_COST_PER_MTOK=0
AI_COMPLETION_COST_PER_MTOK=0

# --- Telegram (Step 6; abstraction registered in Step 1) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Bird / WhatsApp OTP verification -----------------------------------
# Account verification by WhatsApp one-time code, delivered through Bird's
# official Channels API (setup guide: docs/BIRD_WHATSAPP_OTP.md).
# Verification stays Telegram-only until the first FOUR values are all set;
# the choice page then offers WhatsApp as well.
# The raw endpoint references the approved WhatsApp template by its
# TEMPLATE-PROJECT ID (a UUID from the Bird workspace), a version
# ("latest" or a version UUID) and a published locale; the six digits are
# passed as the template variable named by BIRD_OTP_TEMPLATE_PARAMETER_KEY.
BIRD_API_KEY=
BIRD_WORKSPACE_ID=
BIRD_WHATSAPP_CHANNEL_ID=
BIRD_OTP_TEMPLATE_PROJECT_ID=
BIRD_OTP_TEMPLATE_VERSION=latest
BIRD_OTP_TEMPLATE_LOCALE=en
BIRD_OTP_TEMPLATE_PARAMETER_KEY=code
BIRD_BASE_URL=https://api.bird.com

VITE_APP_NAME="${APP_NAME}"
