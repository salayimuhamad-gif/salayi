includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6

    paths:
        - app
        - config
        - database
        - routes
        - tests

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor

    # Modules resolve their own migrations/translations by convention, so the
    # discovery paths are not statically knowable.
    scanDirectories:
        - app/Modules
        # Release tooling is loaded with require() by the scripts and by
        # the standalone suite, so it is real code with no autoload entry.
        - scripts/support

    checkModelProperties: true
    checkOctaneCompatibility: false
    reportUnmatchedIgnoredErrors: true

    # No ignoreErrors. The only entry here silenced env() calls in config/*,
    # and PHPStan's own reportUnmatchedIgnoredErrors showed it matched nothing —
    # a dead suppression. Removing it keeps the configuration honest; nothing is
    # being hidden, because there was nothing behind it.
    # (superseded by the scoped entries below)
    

    # v6 merge: four larastan style hints on the strict cleanup migrations.
    # Each fires on a GROUP BY whose result is counted; the rule's suggested
    # query-level count() would count ROWS rather than GROUPS, which is a
    # different number and would change fail-closed behaviour. These are
    # scoped by identifier AND path — not blanket suppressions — and the
    # behaviour itself is covered by the migration tests.
    ignoreErrors:
        -
            identifier: larastan.noUnnecessaryCollectionCall
            path: app/Modules/Projects/Database/Migrations/2026_07_25_001700_cleanup_job_identity.php
        -
            identifier: larastan.noUnnecessaryCollectionCall
            path: app/Modules/Projects/Database/Migrations/2026_07_25_001900_immutable_cleanup_incidents.php
        -
            identifier: larastan.noUnnecessaryCollectionCall
            path: app/Modules/Projects/Database/Migrations/2026_07_25_002000_reconcile_cleanup_ledger_schema.php
